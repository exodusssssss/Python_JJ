def max_min(liste):
    if not liste:
        return None

    valeur_max = liste[0]
    valeur_min = liste[0]
    imax = 0
    imin = 0

    for i in range(1, len(liste)):
        if liste[i] > valeur_max:
            valeur_max = liste[i]
            imax = i
        if liste[i] < valeur_min:
            valeur_min = liste[i]
            imin = i

    return {"max": valeur_max, "min": valeur_min, "imax": imax, "imin": imin}

print(max_min([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]))


def sum_list(l1,l2):
    l3 = []
    longueur_max = max(len(l1), len(l2))
    for i in range(longueur_max):
        val1 = l1[i] if i < len(l1) else 0
        val2 = l2[i] if i < len(l2) else 0
        l3.append(val1 + val2)
    return l3

print(sum_list([1, 2, 3], [4, 5, 6, 7]))


